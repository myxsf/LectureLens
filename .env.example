# --- 服务端 ---
# 监听地址（默认 127.0.0.1:3001；容器里用 0.0.0.0:3001）
ADDR=127.0.0.1:3001
# 静态资源目录
DIST_DIR=dist
# 字体等资源目录
ASSETS_DIR=assets

# --- PPT 转换（三选一，按顺序生效）---
# 1) 自建转换服务（推荐线上使用；docker compose up -d converter 后会得到这个地址）
# REMOTE_CONVERT_URL=http://127.0.0.1:8000/convert
# 2) 本机 LibreOffice（留空则自动探测 /Applications/LibreOffice.app/...、/opt/homebrew/bin/soffice 等）
# SOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
# 3) 都没有时：浏览器内置渲染器自动兜底，无需配置

# --- 仅转换服务使用 ---
PORT=8000
MAX_UPLOAD_MB=100
CONVERT_TIMEOUT_MS=120000
